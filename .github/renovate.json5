{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": [
		// Renovate's recommended defaults: grouping, automerge, ignore patterns, etc.
		"config:recommended"
	],
	// Explicit prefix for all Renovate branches; keeps them easy to filter and identify.
	"branchPrefix": "renovate/",
	// Only manage GitHub Actions pins and the custom regex manager for buildargs.conf.
	// The Dart dependencies in pubspec.yaml are resolved inside the image build and
	// are deliberately not managed here.
	"enabledManagers": [
		"github-actions",
		"custom.regex"
	],
	// Interpret all schedule strings (e.g. automergeSchedule) in Berlin local time.
	"timezone": "Europe/Berlin",
	// Automerge only during business hours to avoid unattended merges at night or on weekends.
	"automergeSchedule": [
		"after 9am and before 4pm every weekday"
	],
	// Squash keeps history linear and the resulting commit is signed by GitHub,
	// satisfying the repo's linear-history and signed-commits rules. GitHub's
	// merge API has no fast-forward option, and rebase merges can't be signed.
	"automergeStrategy": "squash",
	// Wait 3 days before opening a PR so yanked or broken releases have time to be caught.
	"minimumReleaseAge": "3 days",
	// Open PRs immediately. Automerge still waits for the stability timer
	// (minimumReleaseAge) and a green build. Do NOT use "not-pending" here: the build
	// runs on pull_request, which can't fire until the PR exists, so "not-pending" would
	// deadlock (no PR -> no build -> branch status never leaves pending -> no PR).
	"prCreation": "immediate",
	"labels": [
		"renovate"
	],
	// Plain commit messages; semantic commit prefixes add noise without benefit here.
	"semanticCommits": "disabled",
	"customManagers": [
		{
			// Parses the inline `# renovate:` comment in buildargs.conf to track the
			// Flutter version, which is not in any standard lockfile.
			"customType": "regex",
			"description": "Update versions in buildargs.conf using inline comments",
			"managerFilePatterns": [
				"/^buildargs\\.conf$/"
			],
			// Captures: datasource, depName, optional extractVersion, optional versioning,
			// and the current value from the variable assignment on the next line.
			"matchStrings": [
				"# renovate: datasource=(?<datasource>[a-z][a-z.-]+) depName=(?<depName>[^\\s]+)(?: extractVersion=(?<extractVersion>[^\\s]+))?(?: versioning=(?<versioning>[^\\s]+))?\\n[A-Z_]+=(?<currentValue>.+)"
			]
		}
	],
	"packageRules": [
		{
			// Automerge non-breaking updates; major updates stay on the Dependency Dashboard
			// for manual review since they may require code changes.
			"description": "Automerge everything except major updates",
			"matchUpdateTypes": ["minor", "patch", "pin", "digest"],
			"automerge": true
		},
		{
			// A Flutter major can move the Dart SDK constraint and the rfw package API,
			// both of which need a human to look at the validator sources.
			"description": "Major updates require manual approval",
			"matchUpdateTypes": ["major"],
			"automerge": false
		},
		{
			// Digest/pin updates carry no release timestamp, so the default
			// minimumReleaseAgeBehaviour=timestamp-required would mark them pending forever
			// and never open/merge a PR. Allow them through the age gate (they still need a
			// green build to automerge).
			"description": "Digests have no release timestamp; don't pend them forever",
			"matchUpdateTypes": ["digest", "pin"],
			"minimumReleaseAgeBehaviour": "timestamp-optional"
		}
	],
	// GitHub's built-in vulnerability alerts are redundant when OSV scanning is on.
	"vulnerabilityAlerts": {
		"enabled": false
	},
	// Use the OSV database for vulnerability scanning — broader coverage than GitHub's alerts.
	"osvVulnerabilityAlerts": true
}
